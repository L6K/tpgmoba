/* ── Variables ─────────────────────────────────────── */
:root {
    --color-bg:           rgb(10, 12, 22);
    --color-nav:          rgb(16, 19, 32);
    --color-panel:        rgb(16, 19, 32);
    --color-panel-header: rgb(22, 26, 42);
    --color-accent:       rgb(46, 107, 242);
    --color-accent-dim:   rgba(46, 107, 242, 0.35);
    --color-text:         rgb(255, 255, 255);
    --color-text-dim:     rgb(170, 180, 205);
    --color-text-muted:   rgb(120, 130, 160);
    --color-online:       rgb(51, 255, 76);
    --color-offline:      rgb(100, 100, 120);
    --color-divider:      rgba(255, 255, 255, 0.08);
    --nav-height:         70px;
    --friend-width:       220px;
}

/* ── Root ──────────────────────────────────────────── */
.root {
    flex-direction: column;
    width: 100%;
    height: 100%;
    background-color: var(--color-bg);
}

/* ── NavBar ────────────────────────────────────────── */
.nav-bar {
    flex-direction: row;
    align-items: center;
    height: var(--nav-height);
    background-color: var(--color-nav);
    padding-left: 20px;
    padding-right: 12px;
}

.logo {
    font-size: 26px;
    -unity-font-style: bold;
    color: var(--color-text);
    width: 160px;
    margin-right: 20px;
    letter-spacing: 3px;
}

.nav-tabs {
    flex-direction: row;
    flex-grow: 1;
}

.nav-tab {
    background-color: rgba(0,0,0,0);
    border-width: 0;
    color: var(--color-text-dim);
    font-size: 17px;
    padding: 0 16px;
    height: 70px;
    border-radius: 0;
    border-bottom-width: 0;
    border-bottom-color: var(--color-accent);
    transition: color 0.15s ease;
    cursor: link;
    letter-spacing: 1px;
}

.nav-tab:hover {
    color: var(--color-text);
    background-color: rgba(255,255,255,0.05);
}

.nav-tab--active {
    color: var(--color-text);
    border-bottom-width: 3px;
    border-bottom-color: var(--color-accent);
}

/* 区切り線 */
.nav-divider {
    width: 1px;
    height: 32px;
    background-color: var(--color-divider);
    margin-left: 8px;
    margin-right: 8px;
}

.nav-right {
    flex-direction: row;
    align-items: center;
}

.nav-icon-btn {
    background-color: rgba(0,0,0,0);
    border-width: 0;
    color: var(--color-text-muted);
    font-size: 15px;
    padding: 0 12px;
    height: 70px;
    border-radius: 0;
    cursor: link;
}

.nav-icon-btn:hover {
    color: var(--color-text);
    background-color: rgba(255,255,255,0.05);
}

/* ── Profile Button ────────────────────────────────── */
.profile-btn {
    width: 42px;
    height: 42px;
    border-radius: 21px;
    background-color: rgba(0,0,0,0);
    border-width: 2px;
    border-color: var(--color-accent-dim);
    padding: 0;
    margin-left: 4px;
    cursor: link;
    align-items: center;
    justify-content: center;
    transition: border-color 0.15s ease;
}

.profile-btn:hover {
    border-color: var(--color-accent);
    background-color: rgba(46, 107, 242, 0.15);
}

.profile-icon {
    width: 34px;
    height: 34px;
    border-radius: 17px;
    /* プレースホルダー: グラデーション風の背景色 */
    background-color: rgb(60, 80, 160);
    /* 実際のアイコン画像は HomeScreenController から設定 */
}

/* ── Main Area ─────────────────────────────────────── */
.main-area {
    flex-direction: row;
    flex-grow: 1;
}

/* ── Content ───────────────────────────────────────── */
.content {
    flex-grow: 1;
    position: relative;
}

.page {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

.page--active {
    display: flex;
}

.page-placeholder {
    font-size: 32px;
    color: var(--color-text-muted);
}

/* ── Party Row（横並び） ───────────────────────────── */
.party-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-grow: 1;
    align-self: stretch;
}

/* ── 空きスロット（特大） ──────────────────────────── */
.party-slot {
    width: 200px;
    height: 200px;
    border-radius: 4px;
    border-width: 2px;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    margin-left: 40px;
    margin-right: 40px;
}

.party-slot--empty {
    border-color: rgba(255, 255, 255, 0.15);
    background-color: rgba(255, 255, 255, 0.03);
    transition: border-color 0.15s ease, background-color 0.15s ease;
    cursor: link;
}

.party-slot--empty:hover {
    border-color: var(--color-accent);
    background-color: rgba(46, 107, 242, 0.08);
}

.party-slot__plus {
    font-size: 48px;
    color: rgba(255, 255, 255, 0.2);
    margin-bottom: 8px;
}

.party-slot--empty:hover .party-slot__plus {
    color: var(--color-accent);
}

.party-slot__invite {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.2);
    -unity-text-align: upper-center;
}

.party-slot--empty:hover .party-slot__invite {
    color: var(--color-text-dim);
}

/* ── 中央：自分アイコン＋名前 ─────────────────────── */
.party-self-col {
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

/* ── Game Icon ─────────────────────────────────────── */
.game-icon {
    width: 280px;
    height: 280px;
    background-color: rgb(16, 20, 36);
    border-width: 2px;
    border-color: var(--color-accent-dim);
    border-radius: 4px;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
    transition: border-color 0.2s ease;
}

.game-icon:hover {
    border-color: var(--color-accent);
}

.game-icon__title {
    font-size: 40px;
    -unity-font-style: bold;
    color: var(--color-text);
    margin-bottom: 6px;
}

.game-icon__subtitle {
    font-size: 14px;
    color: var(--color-text-dim);
    letter-spacing: 2px;
}

.player-name {
    font-size: 18px;
    color: var(--color-text);
    -unity-text-align: upper-center;
}

/* ── Play Button（画面下部固定） ───────────────────── */
.play-btn {
    align-self: center;
    margin-bottom: 36px;
    width: 230px;
    height: 62px;
    background-color: var(--color-accent);
    border-width: 0;
    border-radius: 4px;
    color: var(--color-text);
    font-size: 22px;
    -unity-font-style: bold;
    transition: background-color 0.15s ease, scale 0.1s ease;
    cursor: link;
}

.play-btn:hover {
    background-color: rgb(70, 130, 255);
    scale: 1.03 1.03;
}

.play-btn:active {
    background-color: rgb(30, 80, 200);
    scale: 0.97 0.97;
}

/* ── Friend Panel ──────────────────────────────────── */
.friend-panel {
    width: var(--friend-width);
    background-color: var(--color-panel);
    flex-direction: column;
    overflow: hidden;
}

.friend-panel__header {
    flex-shrink: 0;
}

.friend-panel__header {
    flex-direction: row;
    height: 50px;
    background-color: var(--color-panel-header);
    align-items: center;
    padding-left: 12px;
}

.friend-panel__title {
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--color-text);
    flex-grow: 1;
}

.friend-count {
    font-size: 13px;
    color: var(--color-text-muted);
    -unity-text-align: middle-right;
    margin-right: 12px;
}

.friend-list {
    flex-grow: 1;
    padding: 8px 0;
}

.friend-row {
    flex-direction: row;
    align-items: center;
    min-height: 52px;
    padding: 6px 12px;
}

.friend-row:hover {
    background-color: rgba(255,255,255,0.05);
}

.friend-dot {
    width: 10px;
    height: 10px;
    border-radius: 5px;
    margin-right: 10px;
}

.friend-dot--online  { background-color: var(--color-online); }
.friend-dot--offline { background-color: var(--color-offline); }

.friend-name {
    font-size: 15px;
    color: var(--color-text);
    flex-grow: 1;
}

.friend-name--offline {
    color: var(--color-text-muted);
}

.friend-info {
    flex-direction: column;
    flex-grow: 1;
    justify-content: center;
}

.friend-status {
    font-size: 11px;
    color: var(--color-text-muted);
    margin-top: 1px;
}

.friend-status--ingame  { color: rgb(255, 180, 50); }
.friend-status--inqueue { color: rgb(50, 200, 255); }
.friend-status--online  { color: var(--color-text-muted); }

.friend-invite-btn {
    display: none;
    width: 48px;
    height: 26px;
    background-color: var(--color-accent);
    border-width: 0;
    border-radius: 4px;
    color: var(--color-text);
    font-size: 12px;
    cursor: link;
    transition: background-color 0.1s ease;
}

.friend-invite-btn:hover {
    background-color: rgb(70, 130, 255);
}

.friend-row:hover .friend-invite-btn {
    display: flex;
}

.friend-level {
    font-size: 12px;
    color: var(--color-text-muted);
    margin-right: 6px;
}

/* ══ 設定オーバーレイ（Valorant 風全画面） ════════════ */

/* 浮いたパネルをやめて全画面を直接覆う */
.overlay {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    /* Valorant 風: 背後のホーム画面を完全に隠すフラットな全画面 */
    background-color: rgb(10, 12, 22);
    flex-direction: column;
}

/* ヘッダー行 */
.settings-header {
    flex-direction: row;
    align-items: center;
    height: 64px;
    padding-left: 48px;
    padding-right: 32px;
    flex-shrink: 0;
}

.settings-title {
    font-size: 22px;
    -unity-font-style: bold;
    color: var(--color-text);
    flex-grow: 1;
    letter-spacing: 2px;
}

.settings-close-btn {
    background-color: rgba(0,0,0,0);
    border-width: 0;
    border-radius: 0;
    color: var(--color-text-muted);
    font-size: 15px;
    cursor: link;
    padding: 0 12px;
    height: 40px;
    transition: color 0.15s ease;
}

.settings-close-btn:hover {
    color: var(--color-text);
}

/* 水平タブ行 */
.settings-tabs {
    flex-direction: row;
    padding-left: 40px;
    flex-shrink: 0;
}

.settings-tab {
    background-color: rgba(0,0,0,0);
    border-width: 0;
    border-radius: 0;
    color: var(--color-text-muted);
    font-size: 15px;
    height: 44px;
    padding: 0 20px;
    -unity-text-align: middle-center;
    cursor: link;
    /* アクティブ状態の下線を準備（厚み 0 → active で 2px に） */
    border-bottom-width: 0;
    border-bottom-color: var(--color-accent);
    transition: color 0.1s ease;
}

.settings-tab:hover {
    color: var(--color-text);
}

.settings-tab--active {
    color: var(--color-text);
    border-bottom-width: 2px;
    border-bottom-color: var(--color-accent);
}

/* タブ行下の 1px 区切り線 */
.settings-tab-divider {
    height: 1px;
    background-color: rgba(255, 255, 255, 0.1);
    flex-shrink: 0;
}

/* コンテンツ領域: 中央寄せ 1 カラム */
.settings-content {
    flex-grow: 1;
    align-items: center;
    padding-top: 32px;
    padding-bottom: 32px;
    overflow: hidden;
    position: relative;
}

/* 表示切替は display で行うため絶対配置は不要。親の align-items: center で中央寄せ */
.settings-page {
    display: none;
    flex-direction: column;
    width: 70%;
    max-width: 880px;
    flex-grow: 1;
}

.settings-page--active {
    display: flex;
}

.settings-section-title {
    font-size: 12px;
    color: var(--color-text-muted);
    margin-bottom: 16px;
    letter-spacing: 2px;
}

/* 設定行 */
.setting-row {
    flex-direction: row;
    align-items: center;
    height: 56px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.06);
}

.setting-label {
    width: 280px;
    font-size: 15px;
    color: var(--color-text);
}

.setting-slider {
    flex-grow: 1;
    margin-left: 8px;
    margin-right: 12px;
}

/* tracker/dragger は Slider の直下ではなく drag-container 配下にあるため子孫セレクタで指定。
   両方とも top:50% + 高さの半分の負マージンで垂直中心を揃える（線が丸の中心を貫通する） */
.setting-slider .unity-base-slider__tracker {
    background-color: rgba(255, 255, 255, 0.15);
    height: 4px;
    border-radius: 2px;
    top: 50%;
    margin-top: -2px;
}

.setting-slider .unity-base-slider__dragger {
    background-color: var(--color-accent);
    width: 16px;
    height: 16px;
    border-radius: 8px;
    border-width: 0;
    top: 50%;
    margin-top: -8px;
}

.setting-value {
    width: 44px;
    font-size: 14px;
    color: var(--color-text-dim);
    -unity-text-align: middle-right;
}

.setting-dropdown {
    flex-grow: 1;
    margin-left: 8px;
}

/* 見た目を持つのはルートではなく内側の __input 要素のため子孫セレクタで指定 */
.setting-dropdown .unity-base-popup-field__input {
    background-color: rgb(22, 26, 42);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
    border-radius: 4px;
    font-size: 15px;
    padding-left: 10px;
}

.setting-dropdown .unity-base-popup-field__text {
    color: var(--color-text);
}

.setting-dropdown .unity-base-popup-field__arrow {
    -unity-background-image-tint-color: var(--color-text-dim);
}

.settings-placeholder {
    font-size: 18px;
    color: var(--color-text-muted);
    -unity-text-align: middle-center;
    flex-grow: 1;
}

/* フッター行 */
.settings-footer {
    height: 64px;
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    padding-right: 48px;
    flex-shrink: 0;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.08);
}

.settings-apply-btn {
    width: 100px;
    height: 38px;
    background-color: var(--color-accent);
    border-width: 0;
    border-radius: 4px;
    color: var(--color-text);
    font-size: 15px;
    -unity-font-style: bold;
    cursor: link;
    transition: background-color 0.15s ease;
}

.settings-apply-btn:hover {
    background-color: rgb(70, 130, 255);
}

.settings-apply-btn:active {
    background-color: rgb(30, 80, 200);
}

/* ══ 所持品ページ ════════════════════════════════════════ */

/* page は position:absolute + align/justify:center なので、
   page--flow で上から縦に流れるレイアウトに上書きする */
.page--flow {
    align-items: flex-start;
    justify-content: flex-start;
    flex-direction: column;
}

/* サブタブ行 */
.inventory-header {
    flex-direction: row;
    flex-shrink: 0;
    padding-left: 40px;
    padding-top: 8px;
}

/* サブタブボタン（設定画面の .settings-tab と同系） */
.inventory-tab {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    color: var(--color-text-muted);
    font-size: 15px;
    height: 44px;
    padding: 0 20px;
    -unity-text-align: middle-center;
    cursor: link;
    border-bottom-width: 0;
    border-bottom-color: var(--color-accent);
    transition: color 0.1s ease;
}

.inventory-tab:hover {
    color: var(--color-text);
}

.inventory-tab--active {
    color: var(--color-text);
    border-bottom-width: 2px;
    border-bottom-color: var(--color-accent);
}

/* タブ下の 1px 区切り線 */
.inventory-divider {
    height: 1px;
    background-color: rgba(255, 255, 255, 0.08);
    flex-shrink: 0;
    align-self: stretch;
}

/* キャラクターグリッド（ScrollView ルート） */
.char-grid {
    flex-grow: 1;
    align-self: stretch;
}

/* ScrollView の content-container は viewport を挟んだ孫要素のため子孫セレクタで指定 */
.char-grid #unity-content-container {
    flex-direction: row;
    flex-wrap: wrap;
    padding: 20px;
    align-content: flex-start;
}

/* 準備中プレースホルダー領域 */
.page-placeholder-area {
    flex-grow: 1;
    align-self: stretch;
    align-items: center;
    justify-content: center;
}

/* ── キャラクターカード ──────────────────────────────── */
.char-card {
    width: 160px;
    height: 210px;
    background-color: rgb(16, 19, 32);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    border-radius: 4px;
    margin: 6px;
    flex-direction: column;
    overflow: hidden;
    cursor: link;
    transition: border-color 0.15s ease, translate 0.15s ease;
}

.char-card:hover {
    border-color: var(--color-accent);
    translate: 0 -3px;
}

/* アイコン領域（上部 160×140） */
.char-card__icon {
    width: 160px;
    height: 140px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    /* themeColor はコントローラーがインラインで設定。
       icon がある場合も同様に backgroundImage をコントローラーで設定 */
    background-size: cover;
    background-position: center;
}

/* 頭文字表示（icon が null の場合） */
.char-card__initial {
    font-size: 48px;
    -unity-font-style: bold;
    color: rgba(255, 255, 255, 0.85);
    -unity-text-align: middle-center;
}

/* カード下部テキスト領域 */
.char-card__name {
    font-size: 15px;
    color: var(--color-text);
    margin-left: 10px;
    margin-right: 10px;
    margin-top: 8px;
    -unity-text-align: upper-left;
}

.char-card__role {
    font-size: 12px;
    color: var(--color-text-muted);
    margin-left: 10px;
    margin-right: 10px;
    margin-top: 2px;
}

/* 未所持カード：彩度・透明度を落とす */
.char-card--locked {
    opacity: 0.45;
}

/* 「未所持」ラベル（カード右上に重ねて表示） */
.char-card__locked-label {
    font-size: 10px;
    color: var(--color-text-muted);
    background-color: rgba(0, 0, 0, 0.55);
    border-radius: 2px;
    padding: 1px 5px;
    position: absolute;
    top: 6px;
    right: 6px;
}

/* ══ ガチャページ ════════════════════════════════════════ */

/* クリスタル残高ヘッダー（右寄せ行） */
.gacha-header {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    padding: 12px 32px 12px 32px;
    flex-shrink: 0;
    align-self: stretch;
}

.gacha-header__label {
    font-size: 13px;
    color: var(--color-text-muted);
    margin-right: 8px;
}

.gacha-header__count {
    font-size: 20px;
    -unity-font-style: bold;
    color: var(--color-text);
}

/* バナー＋ボタンを縦に中央寄せするコンテナ */
.gacha-body {
    flex-grow: 1;
    align-self: stretch;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

/* バナーカード */
.gacha-banner {
    width: 520px;
    height: 240px;
    background-color: rgb(16, 19, 32);
    border-width: 1px;
    border-color: var(--color-accent);
    border-radius: 4px;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    margin-bottom: 32px;
}

.gacha-banner__title {
    font-size: 24px;
    -unity-font-style: bold;
    color: var(--color-text);
    letter-spacing: 3px;
    margin-bottom: 10px;
}

.gacha-banner__subtitle {
    font-size: 13px;
    color: var(--color-text-muted);
}

/* ボタン行 */
.gacha-buttons {
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

/* ガチャボタン共通 */
.gacha-btn {
    width: 200px;
    height: 54px;
    border-radius: 4px;
    font-size: 17px;
    -unity-font-style: bold;
    cursor: link;
    transition: background-color 0.15s ease, border-color 0.15s ease;
}

/* 単発（セカンダリ）: 透過背景 + 白枠 */
.gacha-btn {
    background-color: rgba(0, 0, 0, 0);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.6);
    color: var(--color-text);
    margin-right: 16px;
}

.gacha-btn:hover {
    border-color: var(--color-accent);
    background-color: rgba(46, 107, 242, 0.1);
}

.gacha-btn:disabled {
    opacity: 0.4;
}

/* 10連（プライマリ）: アクセント塗り */
.gacha-btn--primary {
    background-color: var(--color-accent);
    border-width: 0;
    color: var(--color-text);
    margin-right: 0;
}

.gacha-btn--primary:hover {
    background-color: rgb(70, 130, 255);
    border-color: rgba(0, 0, 0, 0);
}

.gacha-btn--primary:active {
    background-color: rgb(30, 80, 200);
}

.gacha-btn--primary:disabled {
    opacity: 0.4;
}

/* ══ ガチャ結果グリッド ══════════════════════════════════ */

/* ScrollView ルート */
.gacha-result-grid {
    flex-grow: 1;
    align-self: stretch;
}

/* ScrollView の content-container は viewport を挟んだ孫要素のため子孫セレクタで指定 */
.gacha-result-grid #unity-content-container {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    padding: 24px;
    align-content: flex-start;
}

/* NEW! バッジ（カード左上に絶対配置） */
.gacha-badge--new {
    font-size: 10px;
    -unity-font-style: bold;
    color: var(--color-text);
    background-color: var(--color-accent);
    border-radius: 2px;
    padding: 2px 5px;
    position: absolute;
    top: 6px;
    left: 6px;
}

/* 重複バッジ */
.gacha-badge--dupe {
    font-size: 10px;
    color: var(--color-text-muted);
    background-color: rgba(80, 80, 100, 0.85);
    border-radius: 2px;
    padding: 2px 5px;
    position: absolute;
    top: 6px;
    left: 6px;
}

/* ══ プロフィールオーバーレイ ════════════════════════════════ */

/* コンテンツ領域: 中央寄せ、上部余白あり */
.profile-content {
    flex-grow: 1;
    align-items: center;
    padding-top: 32px;
    padding-bottom: 32px;
    overflow: hidden;
}

/* 1カラムコンテナ: settings-page と同幅・同構造だが常時 flex 表示 */
.profile-column {
    flex-direction: column;
    width: 70%;
    max-width: 880px;
    flex-grow: 1;
}

/* プレイヤーアイコン（96px 円形） */
.profile-overlay__icon {
    width: 96px;
    height: 96px;
    border-radius: 48px;
    background-color: rgb(60, 80, 160);
    align-self: center;
    border-width: 2px;
    border-color: var(--color-accent);
}

/* プレイヤー名 */
.profile-overlay__name {
    font-size: 22px;
    -unity-font-style: bold;
    color: var(--color-text);
    letter-spacing: 1px;
    align-self: center;
    margin-top: 12px;
}

/* レベル表示 */
.profile-overlay__level {
    font-size: 14px;
    color: var(--color-text-muted);
    align-self: center;
    margin-bottom: 24px;
}

/* 統計値（setting-row 内で右寄せ） */
.profile-stat-value {
    font-size: 15px;
    color: var(--color-text);
    -unity-text-align: middle-right;
    flex-grow: 1;
}

/* 戦績セクション見出しに上マージンを付与するモディファイア */
.settings-section-title--spaced {
    margin-top: 28px;
}

/* ── リバインドボタン ────────────────────────────────── */
.rebind-btn {
    width: 160px;
    height: 36px;
    background-color: rgb(22, 26, 42);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
    border-radius: 4px;
    color: var(--color-text);
    font-size: 14px;
    cursor: link;
    transition: border-color 0.15s ease;
}

.rebind-btn:hover {
    border-color: var(--color-accent);
}

/* キー入力待ち状態: アクセント枠 + 文字色をアクセントカラーに */
.rebind-btn--listening {
    border-color: var(--color-accent);
    color: var(--color-accent);
}
