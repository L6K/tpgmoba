/* ── Variables ─────────────────────────────────────── */
:root {
    --color-bg:           rgb(15, 15, 31);
    --color-nav:          rgb(25, 25, 46);
    --color-panel:        rgb(25, 25, 51);
    --color-panel-header: rgb(35, 35, 66);
    --color-accent:       rgb(46, 107, 242);
    --color-accent-dim:   rgba(46, 107, 242, 0.35);
    --color-text:         rgb(255, 255, 255);
    --color-text-dim:     rgb(180, 200, 255);
    --color-text-muted:   rgb(120, 130, 160);
    --color-online:       rgb(51, 255, 76);
    --color-offline:      rgb(100, 100, 120);
    --color-divider:      rgba(255, 255, 255, 0.12);
    --nav-height:         70px;
    --friend-width:       220px;
}

/* ── Root ──────────────────────────────────────────── */
.root {
    flex-direction: column;
    width: 100%;
    height: 100%;
    background-color: var(--color-bg);
}

/* ── NavBar ────────────────────────────────────────── */
.nav-bar {
    flex-direction: row;
    align-items: center;
    height: var(--nav-height);
    background-color: var(--color-nav);
    padding-left: 20px;
    padding-right: 12px;
}

.logo {
    font-size: 26px;
    -unity-font-style: bold;
    color: var(--color-text);
    width: 160px;
    margin-right: 20px;
}

.nav-tabs {
    flex-direction: row;
    flex-grow: 1;
}

.nav-tab {
    background-color: rgba(0,0,0,0);
    border-width: 0;
    color: var(--color-text-dim);
    font-size: 17px;
    padding: 0 16px;
    height: 70px;
    border-radius: 0;
    border-bottom-width: 0;
    border-bottom-color: var(--color-accent);
    transition: color 0.15s ease;
    cursor: link;
}

.nav-tab:hover {
    color: var(--color-text);
    background-color: rgba(255,255,255,0.05);
}

.nav-tab--active {
    color: var(--color-text);
    border-bottom-width: 3px;
    border-bottom-color: var(--color-accent);
}

/* 区切り線 */
.nav-divider {
    width: 1px;
    height: 32px;
    background-color: var(--color-divider);
    margin-left: 8px;
    margin-right: 8px;
}

.nav-right {
    flex-direction: row;
    align-items: center;
}

.nav-icon-btn {
    background-color: rgba(0,0,0,0);
    border-width: 0;
    color: var(--color-text-muted);
    font-size: 15px;
    padding: 0 12px;
    height: 70px;
    border-radius: 0;
    cursor: link;
}

.nav-icon-btn:hover {
    color: var(--color-text);
    background-color: rgba(255,255,255,0.05);
}

/* ── Profile Button ────────────────────────────────── */
.profile-btn {
    width: 42px;
    height: 42px;
    border-radius: 21px;
    background-color: rgba(0,0,0,0);
    border-width: 2px;
    border-color: var(--color-accent-dim);
    padding: 0;
    margin-left: 4px;
    cursor: link;
    align-items: center;
    justify-content: center;
    transition: border-color 0.15s ease;
}

.profile-btn:hover {
    border-color: var(--color-accent);
    background-color: rgba(46, 107, 242, 0.15);
}

.profile-icon {
    width: 34px;
    height: 34px;
    border-radius: 17px;
    /* プレースホルダー: グラデーション風の背景色 */
    background-color: rgb(60, 80, 160);
    /* 実際のアイコン画像は HomeScreenController から設定 */
}

/* ── Main Area ─────────────────────────────────────── */
.main-area {
    flex-direction: row;
    flex-grow: 1;
}

/* ── Content ───────────────────────────────────────── */
.content {
    flex-grow: 1;
    position: relative;
}

.page {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

.page--active {
    display: flex;
}

.page-placeholder {
    font-size: 32px;
    color: var(--color-text-muted);
}

/* ── Party Row（横並び） ───────────────────────────── */
.party-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-grow: 1;
    align-self: stretch;
}

/* ── 空きスロット（特大） ──────────────────────────── */
.party-slot {
    width: 200px;
    height: 200px;
    border-radius: 16px;
    border-width: 2px;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    margin-left: 40px;
    margin-right: 40px;
}

.party-slot--empty {
    border-color: rgba(255, 255, 255, 0.15);
    background-color: rgba(255, 255, 255, 0.03);
    transition: border-color 0.15s ease, background-color 0.15s ease;
    cursor: link;
}

.party-slot--empty:hover {
    border-color: var(--color-accent);
    background-color: rgba(46, 107, 242, 0.08);
}

.party-slot__plus {
    font-size: 48px;
    color: rgba(255, 255, 255, 0.2);
    margin-bottom: 8px;
}

.party-slot--empty:hover .party-slot__plus {
    color: var(--color-accent);
}

.party-slot__invite {
    font-size: 13px;
    color: rgba(255, 255, 255, 0.2);
    -unity-text-align: upper-center;
}

.party-slot--empty:hover .party-slot__invite {
    color: var(--color-text-dim);
}

/* ── 中央：自分アイコン＋名前 ─────────────────────── */
.party-self-col {
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

/* ── Game Icon ─────────────────────────────────────── */
.game-icon {
    width: 280px;
    height: 280px;
    background-color: rgb(26, 31, 71);
    border-width: 2px;
    border-color: var(--color-accent-dim);
    border-radius: 4px;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
    transition: border-color 0.2s ease;
}

.game-icon:hover {
    border-color: var(--color-accent);
}

.game-icon__title {
    font-size: 40px;
    -unity-font-style: bold;
    color: var(--color-text);
    margin-bottom: 6px;
}

.game-icon__subtitle {
    font-size: 14px;
    color: var(--color-text-dim);
    letter-spacing: 2px;
}

.player-name {
    font-size: 18px;
    color: var(--color-text);
    -unity-text-align: upper-center;
}

/* ── Play Button（画面下部固定） ───────────────────── */
.play-btn {
    align-self: center;
    margin-bottom: 36px;
    width: 230px;
    height: 62px;
    background-color: var(--color-accent);
    border-width: 0;
    border-radius: 4px;
    color: var(--color-text);
    font-size: 22px;
    -unity-font-style: bold;
    transition: background-color 0.15s ease, scale 0.1s ease;
    cursor: link;
}

.play-btn:hover {
    background-color: rgb(70, 130, 255);
    scale: 1.03 1.03;
}

.play-btn:active {
    background-color: rgb(30, 80, 200);
    scale: 0.97 0.97;
}

/* ── Friend Panel ──────────────────────────────────── */
.friend-panel {
    width: var(--friend-width);
    background-color: var(--color-panel);
    flex-direction: column;
}

.friend-panel__header {
    height: 50px;
    background-color: var(--color-panel-header);
    align-items: center;
    justify-content: center;
}

.friend-panel__header {
    flex-direction: row;
}

.friend-panel__title {
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--color-text);
    flex-grow: 1;
}

.friend-count {
    font-size: 13px;
    color: var(--color-text-muted);
    -unity-text-align: middle-right;
    margin-right: 12px;
}

.friend-list {
    flex-grow: 1;
    padding: 8px 0;
}

.friend-row {
    flex-direction: row;
    align-items: center;
    height: 44px;
    padding: 0 12px;
}

.friend-row:hover {
    background-color: rgba(255,255,255,0.05);
}

.friend-dot {
    width: 10px;
    height: 10px;
    border-radius: 5px;
    margin-right: 10px;
}

.friend-dot--online  { background-color: var(--color-online); }
.friend-dot--offline { background-color: var(--color-offline); }

.friend-name {
    font-size: 15px;
    color: var(--color-text);
    flex-grow: 1;
}

.friend-name--offline {
    color: var(--color-text-muted);
}

.friend-info {
    flex-direction: column;
    flex-grow: 1;
    justify-content: center;
}

.friend-status {
    font-size: 11px;
    color: var(--color-text-muted);
    margin-top: 1px;
}

.friend-status--ingame  { color: rgb(255, 180, 50); }
.friend-status--inqueue { color: rgb(50, 200, 255); }
.friend-status--online  { color: var(--color-text-muted); }

.friend-invite-btn {
    display: none;
    width: 48px;
    height: 26px;
    background-color: var(--color-accent);
    border-width: 0;
    border-radius: 4px;
    color: var(--color-text);
    font-size: 12px;
    cursor: link;
    transition: background-color 0.1s ease;
}

.friend-invite-btn:hover {
    background-color: rgb(70, 130, 255);
}

.friend-row:hover .friend-invite-btn {
    display: flex;
}

.friend-level {
    font-size: 12px;
    color: var(--color-text-muted);
    margin-right: 6px;
}

/* ══ 設定オーバーレイ ══════════════════════════════ */

.overlay {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 0.65);
    align-items: center;
    justify-content: center;
}

.settings-panel {
    width: 760px;
    height: 520px;
    background-color: rgb(20, 20, 40);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    flex-direction: column;
}

/* ヘッダー */
.settings-header {
    flex-direction: row;
    align-items: center;
    height: 56px;
    padding-left: 24px;
    padding-right: 16px;
    background-color: rgb(25, 25, 50);
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.08);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
}

.settings-title {
    font-size: 20px;
    -unity-font-style: bold;
    color: var(--color-text);
    flex-grow: 1;
}

.settings-close-btn {
    width: 36px;
    height: 36px;
    border-radius: 18px;
    background-color: rgba(0,0,0,0);
    border-width: 0;
    color: var(--color-text-muted);
    font-size: 18px;
    cursor: link;
    transition: color 0.15s ease, background-color 0.15s ease;
}

.settings-close-btn:hover {
    color: var(--color-text);
    background-color: rgba(255, 255, 255, 0.1);
}

/* ボディ */
.settings-body {
    flex-direction: row;
    flex-grow: 1;
}

/* 左タブリスト */
.settings-tabs {
    width: 160px;
    flex-direction: column;
    background-color: rgb(17, 17, 35);
    border-right-width: 1px;
    border-right-color: rgba(255, 255, 255, 0.08);
    padding-top: 12px;
}

.settings-tab {
    background-color: rgba(0,0,0,0);
    border-width: 0;
    border-radius: 0;
    color: var(--color-text-muted);
    font-size: 15px;
    height: 44px;
    padding-left: 20px;
    -unity-text-align: middle-left;
    cursor: link;
    border-left-width: 3px;
    border-left-color: rgba(0,0,0,0);
    transition: color 0.1s ease;
}

.settings-tab:hover {
    color: var(--color-text);
    background-color: rgba(255, 255, 255, 0.05);
}

.settings-tab--active {
    color: var(--color-text);
    background-color: rgba(46, 107, 242, 0.12);
    border-left-color: var(--color-accent);
}

/* 右コンテンツ */
.settings-content {
    flex-grow: 1;
    padding: 24px 28px;
    position: relative;
}

.settings-page {
    display: none;
    flex-direction: column;
    position: absolute;
    left: 28px; top: 24px; right: 28px; bottom: 24px;
}

.settings-page--active {
    display: flex;
}

.settings-section-title {
    font-size: 13px;
    color: var(--color-text-muted);
    margin-bottom: 20px;
    letter-spacing: 1px;
}

/* 設定行 */
.setting-row {
    flex-direction: row;
    align-items: center;
    height: 52px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.05);
}

.setting-label {
    width: 120px;
    font-size: 15px;
    color: var(--color-text);
}

.setting-slider {
    flex-grow: 1;
    margin-left: 8px;
    margin-right: 12px;
}

.setting-slider > .unity-base-slider__tracker {
    background-color: rgba(255, 255, 255, 0.15);
    height: 4px;
    border-radius: 2px;
}

.setting-slider > .unity-base-slider__dragger {
    background-color: var(--color-accent);
    width: 16px;
    height: 16px;
    border-radius: 8px;
    border-width: 0;
    margin-top: -6px;
}

.setting-value {
    width: 44px;
    font-size: 14px;
    color: var(--color-text-dim);
    -unity-text-align: middle-right;
}

.setting-dropdown {
    flex-grow: 1;
    margin-left: 8px;
    background-color: rgb(30, 30, 55);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
    border-radius: 4px;
    color: var(--color-text);
    font-size: 15px;
}

.settings-placeholder {
    font-size: 18px;
    color: var(--color-text-muted);
    -unity-text-align: middle-center;
    flex-grow: 1;
}

/* フッター */
.settings-footer {
    height: 60px;
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    padding-right: 20px;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.08);
}

.settings-apply-btn {
    width: 100px;
    height: 38px;
    background-color: var(--color-accent);
    border-width: 0;
    border-radius: 4px;
    color: var(--color-text);
    font-size: 15px;
    -unity-font-style: bold;
    cursor: link;
    transition: background-color 0.15s ease;
}

.settings-apply-btn:hover {
    background-color: rgb(70, 130, 255);
}

.settings-apply-btn:active {
    background-color: rgb(30, 80, 200);
}
