/* ── デザイントークン（HomeScreen.uss と統一） ───────── */
:root {
    --color-bg:        rgb(10, 12, 22);
    --color-accent:    rgb(46, 107, 242);
    --color-text:      rgb(255, 255, 255);
    --color-text-dim:  rgb(170, 180, 205);
    --color-divider:   rgba(255, 255, 255, 0.08);
    --color-hud-bg:    rgba(10, 12, 22, 0.72);
    --color-cd-overlay: rgba(0, 0, 0, 0.62);
}

/* ── ルート: 全画面・透明・ゲーム操作を遮らない ─────── */
.hud-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0);
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
}

/* ── タイマー（上部中央） ───────────────────────────── */
.hud-timer-container {
    align-self: center;
    margin-top: 12px;
    background-color: var(--color-hud-bg);
    border-radius: 4px;
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 4px;
    padding-bottom: 4px;
    border-width: 1px;
    border-color: var(--color-divider);
}

.hud-timer {
    font-size: 20px;
    color: var(--color-text);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 3px;
}

/* ── 下部バー全体 ───────────────────────────────────── */
.hud-bottom {
    flex-direction: row;
    align-items: flex-end;
    justify-content: center;
    align-self: stretch;
    margin-bottom: 20px;
    padding-left: 24px;
    padding-right: 24px;
}

/* ── HP パネル（下部左） ────────────────────────────── */
.hud-hp-panel {
    flex-direction: column;
    align-items: flex-start;
    background-color: var(--color-hud-bg);
    border-radius: 4px;
    padding: 8px 12px;
    border-width: 1px;
    border-color: var(--color-divider);
    margin-right: 20px;
    min-width: 180px;
}

.hud-hp-label {
    font-size: 11px;
    color: var(--color-text-dim);
    letter-spacing: 2px;
    margin-bottom: 4px;
}

.hud-hp-bar-bg {
    width: 160px;
    height: 8px;
    background-color: rgba(255, 255, 255, 0.12);
    border-radius: 2px;
    overflow: hidden;
    margin-bottom: 4px;
}

/* fill の width は GameHudController が % で制御する */
.hud-hp-fill {
    height: 100%;
    width: 100%;
    background-color: var(--color-accent);
    border-radius: 2px;
}

.hud-hp-text {
    font-size: 12px;
    color: var(--color-text-dim);
}

/* ── レベル行（Lvバッジ + XP バー） ─────────────────── */
.hud-level-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 5px;
}

/* アクセント色の小バッジ風ラベル */
.hud-level {
    font-size: 11px;
    -unity-font-style: bold;
    color: var(--color-text);
    background-color: var(--color-accent);
    border-radius: 3px;
    padding-left: 5px;
    padding-right: 5px;
    padding-top: 1px;
    padding-bottom: 1px;
    margin-right: 6px;
}

/* XP バー背景: 細い帯（高さ4px） */
.hud-xp-bar-bg {
    flex-grow: 1;
    height: 4px;
    background-color: rgba(255, 255, 255, 0.15);
    border-radius: 2px;
    overflow: hidden;
}

/* XP fill: 白〜アクセントの控えめなグラデーション風（単色で代替） */
/* width は GameHudController が % で制御する */
.hud-xp-fill {
    height: 100%;
    width: 100%;
    background-color: rgba(130, 180, 255, 0.75);
    border-radius: 2px;
}

/* ── スキルスロット列（下部中央） ───────────────────── */
.hud-skills {
    flex-direction: row;
    align-items: flex-end;
}

/* 各スロット: 64x64 の角丸ボックス */
.hud-skill-slot {
    width: 64px;
    height: 64px;
    background-color: var(--color-hud-bg);
    border-radius: 4px;
    border-width: 1px;
    border-color: var(--color-divider);
    margin-left: 6px;
    margin-right: 6px;
    position: relative;
    overflow: hidden;
    align-items: center;
    justify-content: flex-start;
    flex-direction: column;
    padding-top: 6px;
    padding-bottom: 0;
}

/* 未設定スロットは彩度・明度を落とす */
.hud-skill-slot--empty {
    opacity: 0.38;
}

/* スキル名（スロット上部・小さい文字） */
.hud-skill-name {
    font-size: 9px;
    color: var(--color-text-dim);
    -unity-text-align: upper-center;
    white-space: normal;
    overflow: hidden;
    max-width: 60px;
    flex-shrink: 1;
    margin-bottom: 2px;
}

/* キー名（スロット下部固定） */
.hud-skill-key {
    position: absolute;
    bottom: 4px;
    left: 0;
    right: 0;
    font-size: 11px;
    color: var(--color-text);
    -unity-font-style: bold;
    -unity-text-align: lower-center;
}

/* CD オーバーレイ: 上から height % で覆う（残 CD が多いほど height 大） */
.hud-skill-cd {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 0%;   /* GameHudController が width/height style で制御 */
    background-color: var(--color-cd-overlay);
}

/* ── チームバフ残り時間（ミニマップ上 16px） ─────────── */
.hud-buff {
    color: rgba(255, 220, 80, 1);
    font-size: 13px;
    -unity-font-style: bold;
    background-color: rgba(0, 0, 0, 0.55);
    padding: 2px 6px;
    border-radius: 4px;
}

/* ── ミニマップパネル（左下固定・160x160 正方形） ─────────── */
.hud-minimap {
    position: absolute;
    left: 16px;
    bottom: 16px;
    width: 160px;
    height: 160px;
    background-color: rgba(10, 12, 22, 0.78);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
    overflow: hidden;
}

/* 川帯（縦方向・中央）: 幅 14/150*160 ≈ 15px、left=(160-15)/2=72px */
.minimap-river {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 72px;
    width: 15px;
    background-color: rgba(46, 107, 242, 0.15);
}

/* ミニマップドット基本スタイル */
.minimap-dot {
    position: absolute;
    width: 6px;
    height: 6px;
    border-radius: 3px;
}

.minimap-dot--blue {
    background-color: rgb(80, 140, 255);
}

.minimap-dot--red {
    background-color: rgb(235, 90, 90);
}

.minimap-dot--neutral {
    background-color: rgb(170, 110, 230);
}

/* 自分（プレイヤー）: 白・8x8・黒枠1px */
.minimap-dot--self {
    background-color: rgb(255, 255, 255);
    width: 8px;
    height: 8px;
    border-radius: 4px;
    border-width: 1px;
    border-color: rgb(0, 0, 0);
}

/* タワー・タイタン: 正方形・8x8 */
.minimap-dot--square {
    width: 8px;
    height: 8px;
    border-radius: 0;
}

/* CD 残秒テキスト（スロット中央） */
.hud-skill-cdtext {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--color-text);
    -unity-text-align: middle-center;
    display: none;
}
