/* ── デザイントークン（LoL 風 金縁ダーク） ───────────── */
:root {
    --color-bg:          rgb(10, 12, 22);
    --color-accent:      rgb(46, 107, 242);
    --color-text:        rgb(255, 255, 255);
    --color-text-dim:    rgb(170, 180, 205);
    --color-divider:     rgba(255, 255, 255, 0.08);
    --color-hud-bg:      rgba(8, 10, 18, 0.92);
    --color-cd-overlay:  rgba(0, 0, 0, 0.65);

    /* LoL ゴールド */
    --color-gold:        rgb(200, 170, 110);
    --color-gold-bright: rgb(235, 200, 90);
    --color-gold-dim:    rgba(200, 170, 110, 0.45);

    /* HP バー */
    --color-hp:          rgb(60, 180, 75);

    /* XP バー */
    --color-xp:          rgb(140, 100, 220);
}

/* ── ルート: 全画面・透明・ゲーム操作を遮らない ─────── */
.hud-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0);
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
}

/* ── タイマー（上部中央） ───────────────────────────── */
.hud-timer-container {
    align-self: center;
    margin-top: 12px;
    background-color: var(--color-hud-bg);
    border-radius: 2px;
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 4px;
    padding-bottom: 4px;
    border-width: 1px;
    border-color: var(--color-gold);
}

.hud-timer {
    font-size: 20px;
    color: var(--color-text);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 3px;
}

/* ── チームバフ残り時間（ミニマップ上 16px） ─────────── */
.hud-buff {
    color: rgba(255, 220, 80, 1);
    font-size: 13px;
    -unity-font-style: bold;
    background-color: rgba(0, 0, 0, 0.55);
    padding: 2px 6px;
    border-radius: 4px;
}

/* ── ミニマップパネル（左下固定・160x160） ─────────── */
.hud-minimap {
    position: absolute;
    left: 16px;
    bottom: 16px;
    width: 160px;
    height: 160px;
    background-color: rgba(10, 12, 22, 0.78);
    border-width: 1px;
    border-color: var(--color-gold-dim);
    overflow: hidden;
}

.minimap-river {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 72px;
    width: 15px;
    background-color: rgba(46, 107, 242, 0.15);
}

.minimap-dot {
    position: absolute;
    width: 6px;
    height: 6px;
    border-radius: 3px;
}

.minimap-dot--blue    { background-color: rgb(80, 140, 255); }
.minimap-dot--red     { background-color: rgb(235, 90, 90); }
.minimap-dot--neutral { background-color: rgb(170, 110, 230); }

.minimap-dot--self {
    background-color: rgb(255, 255, 255);
    width: 8px;
    height: 8px;
    border-radius: 4px;
    border-width: 1px;
    border-color: rgb(0, 0, 0);
}

.minimap-dot--square {
    width: 8px;
    height: 8px;
    border-radius: 0;
}

/* ── 下部統合パネル（LoL 風・幅 820px・高さ 110px） ─── */
.hud-bottom {
    position: relative;
    flex-direction: row;
    align-items: center;
    align-self: center;
    margin-bottom: 14px;
    width: 820px;
    height: 110px;
    background-color: var(--color-hud-bg);
    border-radius: 2px;
    border-width: 1px;
    border-color: var(--color-gold);
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 0;
    padding-bottom: 0;
    overflow: hidden;
}

/* 上辺の細いハイライトライン */
.hud-bottom-highlight {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 1px;
    background-color: rgba(255, 240, 180, 0.30);
}

/* ── ポートレートセクション（左端） ─────────────────── */
.hud-portrait-section {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    margin-right: 10px;
    flex-shrink: 0;
}

/* ポートレート外枠（72x72・金縁） */
.hud-portrait-frame {
    width: 72px;
    height: 72px;
    border-width: 1px;
    border-color: var(--color-gold);
    border-radius: 2px;
    position: relative;
    overflow: hidden;
}

/* ポートレート背景（テーマカラー塗り） */
.hud-portrait-bg {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(28, 36, 60);
    align-items: center;
    justify-content: center;
}

/* ポートレート頭文字（装飾のみ） */
.hud-portrait-initial {
    font-size: 28px;
    -unity-font-style: bold;
    color: var(--color-gold);
    -unity-text-align: middle-center;
    letter-spacing: 0;
}

/* レベルバッジ: ポートレート左下に金色バッジで重ねる */
.hud-level {
    position: absolute;
    bottom: 0;
    left: 0;
    font-size: 10px;
    -unity-font-style: bold;
    color: rgb(15, 15, 20);
    background-color: var(--color-gold);
    border-radius: 0;
    padding-left: 4px;
    padding-right: 4px;
    padding-top: 1px;
    padding-bottom: 1px;
}

/* ── HP・XP・スキルセクション（中央） ───────────────── */
.hud-bars-section {
    flex-direction: column;
    align-items: stretch;
    flex-grow: 1;
    justify-content: center;
    margin-right: 8px;
}

/* HP バー行 */
.hud-hp-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 3px;
}

/* HP バー背景（高さ 16px） */
.hud-hp-bar-bg {
    flex-grow: 1;
    height: 16px;
    background-color: rgba(255, 255, 255, 0.10);
    border-radius: 1px;
    overflow: hidden;
    position: relative;
}

/* HP ダメージトレイル: fill の下に置き、transition の遅延差でトレイルが生まれる */
.hud-hp-damage {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 100%;
    background-color: rgba(255, 240, 215, 0.85);
    transition: width 0.45s ease 0.25s;
}

/* HP fill: LoL 風グリーン（width は Controller が % 制御） */
.hud-hp-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 100%;
    background-color: var(--color-hp);
    border-radius: 1px;
    transition: width 0.12s ease-out;
}

/* 低 HP 警告色（比率 < 0.3 で付与） */
.hud-hp-fill--low {
    background-color: rgb(214, 84, 48);
}

/* HP テキスト: バー中央に白字で重ねる */
.hud-hp-text {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    font-size: 11px;
    -unity-font-style: bold;
    color: var(--color-text);
    -unity-text-align: middle-center;
}

/* XP バー背景（高さ 5px） */
.hud-xp-bar-bg {
    flex-grow: 1;
    height: 5px;
    background-color: rgba(255, 255, 255, 0.10);
    border-radius: 1px;
    overflow: hidden;
    margin-bottom: 6px;
}

/* XP fill: 紫系（width は Controller が % 制御） */
.hud-xp-fill {
    height: 100%;
    width: 100%;
    background-color: var(--color-xp);
    border-radius: 1px;
    transition: width 0.25s ease-out;
}

/* ── スキルスロット列 ────────────────────────────────── */
.hud-skills {
    flex-direction: row;
    align-items: flex-end;
    margin-top: 2px;
}

/* 各スロット: 56x56・金縁・ほぼ直角 */
.hud-skill-slot {
    width: 56px;
    height: 56px;
    background-color: rgba(15, 18, 32, 0.90);
    border-radius: 2px;
    border-width: 1px;
    border-color: var(--color-gold);
    margin-right: 5px;
    position: relative;
    overflow: hidden;
    align-items: center;
    justify-content: flex-start;
    flex-direction: column;
    padding-top: 5px;
}

/* 未設定スロット */
.hud-skill-slot--empty {
    opacity: 0.35;
    border-color: rgba(200, 170, 110, 0.30);
}

/* スキル名（スロット上部） */
.hud-skill-name {
    font-size: 8px;
    color: var(--color-text-dim);
    -unity-text-align: upper-center;
    white-space: normal;
    overflow: hidden;
    max-width: 52px;
    flex-shrink: 1;
    margin-bottom: 1px;
}

/* キー名バッジ（右下・金色） */
.hud-skill-key {
    position: absolute;
    bottom: 2px;
    right: 3px;
    font-size: 9px;
    -unity-font-style: bold;
    color: rgb(15, 15, 20);
    background-color: var(--color-gold);
    border-radius: 1px;
    padding-left: 2px;
    padding-right: 2px;
    padding-top: 0;
    padding-bottom: 0;
    -unity-text-align: middle-center;
}

/* CD オーバーレイ: 上から height % で覆う */
.hud-skill-cd {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 0%;
    background-color: var(--color-cd-overlay);
}

/* CD 残秒テキスト */
.hud-skill-cdtext {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    font-size: 15px;
    -unity-font-style: bold;
    color: var(--color-text);
    -unity-text-align: middle-center;
    display: none;
}

/* ── 右セクション（アイテム 3x2 + 所持金） ──────────── */
.hud-right-section {
    flex-direction: column;
    align-items: flex-end;
    justify-content: center;
    flex-shrink: 0;
    margin-left: 4px;
}

/* アイテム枠コンテナ（3x2 グリッド） */
.hud-item-slots {
    flex-direction: column;
    align-items: flex-start;
    margin-bottom: 4px;
}

/* アイテム行（3枠 x 2行） */
.hud-item-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 2px;
}

/* 各アイテムスロット: 28x28・薄い金縁 */
.hud-item-slot {
    width: 28px;
    height: 28px;
    background-color: rgba(15, 18, 32, 0.80);
    border-radius: 1px;
    border-width: 1px;
    border-color: rgba(200, 170, 110, 0.40);
    margin-right: 2px;
    align-items: center;
    justify-content: center;
    overflow: hidden;
}

/* アイテム頭文字 */
.hud-item-initial {
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--color-text);
    -unity-text-align: middle-center;
}

/* 所持金（アイテム枠右に金色太字） */
.hud-gold {
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--color-gold-bright);
    -unity-text-align: middle-right;
    letter-spacing: 0;
    padding-right: 2px;
    transition: color 0.2s, scale 0.2s;
}

/* 所持金増加パルスエフェクト */
.hud-gold--pulse {
    color: rgb(255, 230, 150);
    scale: 1.12 1.12;
}

/* ── ショップ範囲外ヒント ────────────────────────────── */
.hud-shop-hint {
    position: absolute;
    bottom: 140px;
    left: 0;
    right: 0;
    -unity-text-align: middle-center;
    font-size: 14px;
    color: rgba(255, 200, 80, 1);
    background-color: rgba(10, 12, 22, 0.85);
    border-radius: 2px;
    border-width: 1px;
    border-color: var(--color-gold-dim);
    padding: 6px 16px;
    align-self: center;
}

/* ── ショップオーバーレイ（全画面・操作遮断） ──────── */
.shop-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(10, 12, 22, 0.96);
    flex-direction: column;
    align-items: stretch;
}

.shop-header {
    flex-direction: row;
    align-items: center;
    padding-left: 32px;
    padding-right: 32px;
    padding-top: 20px;
    padding-bottom: 16px;
    border-bottom-width: 1px;
    border-color: var(--color-gold-dim);
}

.shop-title {
    font-size: 22px;
    -unity-font-style: bold;
    color: var(--color-text);
    flex-grow: 1;
}

.shop-gold {
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--color-gold-bright);
    margin-right: 24px;
}

.shop-close {
    font-size: 14px;
    color: var(--color-text);
    background-color: rgba(255, 255, 255, 0.08);
    border-radius: 2px;
    border-width: 1px;
    border-color: var(--color-gold-dim);
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 6px;
    padding-bottom: 6px;
}

.shop-grid {
    flex-direction: row;
    flex-wrap: wrap;
    padding: 20px 24px;
    flex-grow: 1;
}

.shop-card {
    width: 200px;
    height: 150px;
    background-color: rgba(255, 255, 255, 0.05);
    border-radius: 2px;
    border-width: 1px;
    border-color: var(--color-gold-dim);
    margin: 8px;
    flex-direction: column;
    overflow: hidden;
}

.shop-card--disabled {
    opacity: 0.4;
}

.shop-card-tile {
    height: 50px;
    align-items: center;
    justify-content: center;
}

.shop-card-initial {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgba(255, 255, 255, 0.90);
}

.shop-card-info {
    flex-grow: 1;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 6px;
    padding-bottom: 6px;
    flex-direction: column;
    justify-content: space-between;
}

.shop-card-name {
    font-size: 13px;
    -unity-font-style: bold;
    color: var(--color-text);
}

.shop-card-effect {
    font-size: 10px;
    color: var(--color-text-dim);
    white-space: normal;
    overflow: hidden;
    flex-grow: 1;
}

.shop-card-price {
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--color-gold-bright);
    -unity-text-align: lower-right;
}
