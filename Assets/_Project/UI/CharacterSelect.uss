/* ── Variables（HomeScreen.uss :root を継承する想定） ─────────────────── */
:root {
    --color-bg:       rgb(10, 12, 22);
    --color-panel:    rgb(16, 19, 32);
    --color-accent:   rgb(46, 107, 242);
    --color-text:     rgb(255, 255, 255);
    --color-text-dim: rgb(170, 180, 205);
    --color-divider:  rgba(255, 255, 255, 0.08);
}

/* ── ルート: 全画面縦積み ──────────────────────────────────────────────── */
.cs-root {
    width: 100%;
    height: 100%;
    background-color: var(--color-bg);
    flex-direction: column;
    align-items: center;
}

/* ── 上部ヘッダー ─────────────────────────────────────────────────────── */
.cs-header {
    flex-direction: column;
    align-items: center;
    padding-top: 24px;
    padding-bottom: 12px;
    flex-shrink: 0;
}

.cs-header__title {
    font-size: 12px;
    color: var(--color-text-dim);
    letter-spacing: 3px;
    margin-bottom: 4px;
}

/* タイマー: 大きく目立たせる */
.cs-timer {
    font-size: 40px;
    -unity-font-style: bold;
    color: var(--color-text);
    letter-spacing: 4px;
    -unity-text-align: middle-center;
}

/* ── 味方スロット行 ────────────────────────────────────────────────────── */
.cs-slots-row {
    flex-direction: row;
    justify-content: center;
    margin-bottom: 16px;
    flex-shrink: 0;
}

.cs-slot {
    width: 150px;
    height: 64px;
    background-color: var(--color-panel);
    border-width: 1px;
    border-color: var(--color-divider);
    border-radius: 4px;
    flex-direction: row;
    align-items: center;
    margin-left: 8px;
    margin-right: 8px;
    overflow: hidden;
}

/* ロック済みスロット: アクセントカラーの枠で強調 */
.cs-slot--locked {
    border-color: var(--color-accent);
    border-width: 2px;
}

.cs-slot__icon {
    width: 40px;
    height: 64px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    /* ThemeColor はコントローラーがインラインで設定 */
}

.cs-slot__initial {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgba(255, 255, 255, 0.85);
    -unity-text-align: middle-center;
}

.cs-slot__info {
    flex-direction: column;
    flex-grow: 1;
    padding-left: 8px;
    padding-right: 6px;
    justify-content: center;
}

.cs-slot__name {
    font-size: 13px;
    color: var(--color-text);
    letter-spacing: 1px;
}

.cs-slot__pick {
    font-size: 11px;
    color: var(--color-text-dim);
    margin-top: 2px;
}

/* ── 中段 ──────────────────────────────────────────────────────────────── */
.cs-middle {
    flex-direction: row;
    flex-grow: 1;
    align-self: stretch;
    padding-left: 24px;
    padding-right: 24px;
    padding-bottom: 8px;
    align-items: stretch;
}

/* ── 左: プレビューパネル ─────────────────────────────────────────────── */
.cs-preview {
    width: 300px;
    flex-shrink: 0;
    flex-direction: column;
    align-items: center;
    background-color: var(--color-panel);
    border-radius: 4px;
    border-width: 1px;
    border-color: var(--color-divider);
    padding: 20px 16px;
    margin-right: 16px;
}

.cs-preview__icon {
    width: 128px;
    height: 128px;
    border-radius: 4px;
    margin-bottom: 14px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    /* ThemeColor はコントローラーがインラインで設定 */
    background-size: cover;
    background-position: center;
}

.cs-preview__initial {
    font-size: 52px;
    -unity-font-style: bold;
    color: rgba(255, 255, 255, 0.85);
    -unity-text-align: middle-center;
}

.cs-preview__name {
    font-size: 22px;
    -unity-font-style: bold;
    color: var(--color-text);
    letter-spacing: 2px;
    -unity-text-align: middle-center;
    margin-bottom: 6px;
}

.cs-preview__role {
    font-size: 13px;
    color: var(--color-accent);
    letter-spacing: 2px;
    -unity-text-align: middle-center;
    margin-bottom: 12px;
}

.cs-preview__desc {
    font-size: 13px;
    color: var(--color-text-dim);
    -unity-text-align: upper-left;
    white-space: normal;
    flex-grow: 1;
    align-self: stretch;
    /* 行折り返しを有効にするため white-space: normal が必要 */
}

/* ── 右: キャラグリッド ────────────────────────────────────────────────── */
.cs-grid {
    flex-grow: 1;
    background-color: var(--color-panel);
    border-radius: 4px;
    border-width: 1px;
    border-color: var(--color-divider);
}

/* ScrollView 内部の content-container は viewport を挟んだ孫要素のため子孫セレクタで指定 */
.cs-grid #unity-content-container {
    flex-direction: row;
    flex-wrap: wrap;
    padding: 12px;
    align-content: flex-start;
}

/* ── グリッドカード ────────────────────────────────────────────────────── */
.cs-card {
    width: 90px;
    height: 110px;
    background-color: rgb(22, 26, 42);
    border-width: 1px;
    border-color: var(--color-divider);
    border-radius: 4px;
    margin: 5px;
    flex-direction: column;
    align-items: center;
    overflow: hidden;
    cursor: link;
    transition: border-color 0.12s ease, translate 0.12s ease;
}

.cs-card:hover {
    border-color: rgba(46, 107, 242, 0.6);
    translate: 0 -2px;
}

/* 選択中カード: アクセントカラー太枠 */
.cs-card--selected {
    border-color: var(--color-accent);
    border-width: 2px;
}

/* 未所持カード: 操作不能 + 半透明 */
.cs-card--locked {
    opacity: 0.35;
    cursor: default;
}

/* カード内: 色タイル+頭文字 */
.cs-card__icon {
    width: 90px;
    height: 70px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    background-size: cover;
    background-position: center;
}

.cs-card__initial {
    font-size: 28px;
    -unity-font-style: bold;
    color: rgba(255, 255, 255, 0.85);
    -unity-text-align: middle-center;
}

.cs-card__name {
    font-size: 10px;
    color: var(--color-text);
    -unity-text-align: middle-center;
    margin-top: 4px;
    padding-left: 4px;
    padding-right: 4px;
    white-space: normal;
}

/* ── レリック選択エリア ────────────────────────────────────────────────── */
.cs-relics {
    align-self: stretch;
    margin-left: 24px;
    margin-right: 24px;
    margin-bottom: 10px;
    padding: 12px 16px;
    background-color: var(--color-panel);
    border-radius: 4px;
    border-width: 1px;
    border-color: var(--color-divider);
    flex-direction: column;
    flex-shrink: 0;
}

.cs-relics-title {
    font-size: 13px;
    color: var(--color-text-dim);
    letter-spacing: 2px;
    margin-bottom: 10px;
}

.cs-relic-list {
    flex-direction: row;
    flex-wrap: wrap;
}

.cs-relic-item {
    min-width: 120px;
    max-width: 200px;
    height: 60px;
    background-color: rgb(22, 26, 42);
    border-width: 1px;
    border-color: var(--color-divider);
    border-radius: 4px;
    margin: 4px;
    padding: 6px 10px;
    color: var(--color-text);
    font-size: 11px;
    cursor: link;
    transition: border-color 0.12s ease;
    white-space: normal;
    -unity-text-align: upper-left;
}

.cs-relic-item:hover {
    border-color: rgba(46, 107, 242, 0.6);
}

/* 選択中レリック: アクセントカラー太枠 */
.cs-relic-item--selected {
    border-color: var(--color-accent);
    border-width: 2px;
}

/* ── ロックインボタン ──────────────────────────────────────────────────── */
.cs-lock-btn {
    align-self: center;
    margin-top: 12px;
    margin-bottom: 28px;
    width: 230px;
    height: 62px;
    background-color: var(--color-accent);
    border-width: 0;
    border-radius: 4px;
    color: var(--color-text);
    font-size: 22px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    transition: background-color 0.15s ease, scale 0.1s ease;
    cursor: link;
    flex-shrink: 0;
}

.cs-lock-btn:hover {
    background-color: rgb(70, 130, 255);
    scale: 1.03 1.03;
}

.cs-lock-btn:active {
    background-color: rgb(30, 80, 200);
    scale: 0.97 0.97;
}

.cs-lock-btn:disabled {
    background-color: rgba(46, 107, 242, 0.35);
    cursor: default;
    scale: 1 1;
}
